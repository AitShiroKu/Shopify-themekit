{% comment %}
  Loox reviews section — displays featured reviews / carousel on any page.
  Requires the Loox app installed. Loox auto-injects its script via the shop's
  script-tag; this section provides the widget mount points.
{% endcomment %}

{% if section.settings.show_section %}
<section class="section loox-section" aria-labelledby="loox-heading-{{ section.id }}">
  <div class="container">
    <div class="section__header section__header--center">
      {% if section.settings.overline != blank %}
        <span class="section__overline">{{ section.settings.overline }}</span>
      {% endif %}
      <h2 class="section__title h2" id="loox-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}
        <p class="section__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if settings.loox_enabled %}
      {% case section.settings.widget_type %}
        {% when 'carousel' %}
          <div id="looxReviewsCarousel"></div>
        {% when 'featured' %}
          <div id="looxReviewsFeatured"></div>
        {% when 'grid' %}
          <div id="looxReviewsGrid"></div>
        {% else %}
          <div id="looxReviewsCarousel"></div>
      {% endcase %}
    {% else %}
      <div class="loox-section__placeholder">
        <p>Enable Loox in theme settings to display reviews here.</p>
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

<style>
  .loox-section { padding: var(--space-3xl) 0; }
  .loox-section__placeholder {
    text-align: center;
    padding: var(--space-2xl);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
  }
</style>

{% schema %}
{
  "name": "Loox reviews",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Happy customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our community" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Real reviews from real shoppers — see what they're saying." },
    {
      "type": "select",
      "id": "widget_type",
      "label": "Widget type",
      "options": [
        { "value": "carousel", "label": "Reviews carousel" },
        { "value": "featured", "label": "Featured reviews" },
        { "value": "grid", "label": "Reviews grid" }
      ],
      "default": "carousel",
      "info": "The widget type must also be enabled inside the Loox app dashboard."
    }
  ],
  "presets": [
    { "name": "Loox reviews", "category": "Homepage" }
  ]
}
{% endschema %}
