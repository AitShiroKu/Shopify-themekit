{% comment %}
  StellarLight Magic — List all collections (/collections)
{% endcomment %}

<div class="collection-header">
  <div class="container">
    <div class="collection-header__no-image">
      <div class="collection-header__content">
        <span class="section__overline">Browse</span>
        <h1 class="collection-header__title">All Collections</h1>
        <p class="collection-header__count">
          {{ collections.size }} {{ collections.size | pluralize: 'collection', 'collections' }}
        </p>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    {% assign visible_count = 0 %}
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        {% assign visible_count = visible_count | plus: 1 %}
      {% endunless %}
    {% endfor %}

    {% if visible_count > 0 %}
      <div class="collection-grid">
        {% for collection in collections %}
          {% unless collection.handle == 'frontpage' %}
            <a href="{{ collection.url }}" class="collection-grid__item">
              <div class="collection-grid__media">
                {% if collection.image %}
                  <img
                    src="{{ collection.image | img_url: '800x800' }}"
                    alt="{{ collection.title | escape }}"
                    loading="lazy"
                    width="800" height="800">
                {% elsif collection.products.first.featured_image %}
                  <img
                    src="{{ collection.products.first.featured_image | img_url: '800x800' }}"
                    alt="{{ collection.title | escape }}"
                    loading="lazy"
                    width="800" height="800">
                {% else %}
                  <div class="collection-grid__placeholder" aria-hidden="true">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="collection-grid__overlay"></div>
              </div>
              <div class="collection-grid__body">
                <h2 class="collection-grid__title">{{ collection.title }}</h2>
                <p class="collection-grid__count">
                  {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
                </p>
              </div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    {% else %}
      <div class="collection-empty">
        <div class="collection-empty__icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          </svg>
        </div>
        <h2 class="collection-empty__title">No collections yet</h2>
        <p class="collection-empty__text">Create collections in your Shopify admin to see them here.</p>
        <a href="{{ routes.root_url }}" class="btn btn--pink">Back to Home</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .collection-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .collection-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .collection-grid__item {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-bouncy), box-shadow var(--transition-base);
    color: inherit;
    text-decoration: none;
  }

  .collection-grid__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .collection-grid__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-cute-peach-soft);
  }

  .collection-grid__media img,
  .collection-grid__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .collection-grid__item:hover .collection-grid__media img {
    transform: scale(1.04);
  }

  .collection-grid__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(13, 27, 46, 0.25) 100%);
    pointer-events: none;
  }

  .collection-grid__body {
    padding: var(--space-lg);
    text-align: center;
  }

  .collection-grid__title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 6px;
  }

  .collection-grid__count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-cute-pink-deep);
    margin: 0;
  }
</style>
